# Шаблон локального .env. Секретов здесь нет и быть не должно.
# Логины и пароли к Cassandra хранятся в Vault (secret/mlops-app),
# сервис получает их на старте через src/vault.py.
#
# Локально: cp .env.example .env
# В CI/CD: этот же файл копируется в .env, секреты приходят из GitHub Secrets
#          и подставляются в vault/seed.sh на лету.

# Порты, которые docker compose подставляет в docker-compose.yml
API_PORT=8000
CASSANDRA_PORT=9042

# Необязательная настройка ретраев подключения к Cassandra
CASSANDRA_CONNECT_RETRIES=3
CASSANDRA_RETRY_DELAY=2.0
